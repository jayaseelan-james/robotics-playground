<?xml version='1.0' encoding='utf-8'?>
<mujoco model="panda pick and hold scene">
  <include file="franka_emika_panda/panda.xml"/>

  <compiler meshdir="franka_emika_panda/assets"/>

  <statistic center="0.4 0 0.3" extent="1.1"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.35 0.35 0.35" specular="0.1 0.1 0.1"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="135" elevation="-25" offwidth="1280" offheight="960"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4"
             rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.1"/>
    <material name="table_mat" rgba="0.45 0.30 0.18 1" specular="0.05" shininess="0.05"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.6" dir="0 0 -1" directional="true" castshadow="false"/>
    <light pos="0.4 0 1.2" dir="-0.3 0 -1" directional="true"/>
  
    <camera name="frontview" pos="1.30 -1.00 0.90" xyaxes="0.762 0.648 0 -0.287 0.338 0.896"/>

    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Table: top surface sits at z = 0.2 -->
    <geom name="table" type="box" pos="0.55 0 0.1" size="0.30 0.42 0.1"
          material="table_mat" friction="1 0.02 0.001" condim="4"/>

    <body name="cube_red" pos="0.5 -0.1 0.22">
      <freejoint name="cube_red_free"/>
      <geom name="cube_red_geom" type="box" size="0.02 0.02 0.02" mass="0.02"
            rgba="0.85 0.2 0.2 1" friction="2.0 0.05 0.0005" condim="6" solref="0.008 1"/>
    </body>

    <body name="cube_blue" pos="0.5 0.1 0.22">
      <freejoint name="cube_blue_free"/>
      <geom name="cube_blue_geom" type="box" size="0.02 0.02 0.02" mass="0.02"
            rgba="0.2 0.35 0.9 1" friction="2.0 0.05 0.0005" condim="6" solref="0.008 1"/>
    </body>

    <!-- Place where objects must end up. A site is a massless, collision-free marker. -->
    <site name="goal" pos="0.45 0.22 0.38" size="0.02" rgba="0.2 0.9 0.2 0.3"/>
  </worldbody>

  <keyframe>
    <key name="start" qpos="0 0 0 -1.57079 0 1.57079 -0.7853 0.04 0.04 0.5 -0.1 0.22 1 0 0 0 0.5 0.1 0.22 1 0 0 0"
     ctrl="0 0 0 -1.57079 0 1.57079 -0.7853 255"/>
  </keyframe>
</mujoco>
